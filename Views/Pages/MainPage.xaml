<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:models="clr-namespace:Products3.Models.SQLModels"
	xmlns:viewmodel="clr-namespace:Products3.Viewmodels"
	xmlns:views="clr-namespace:Products3.Views"
	xmlns:local="clr-namespace:Products3.Viewmodels"
             x:DataType="viewmodel:MainPageViewModel"
             x:Class="Products3.Views.Pages.MainPage"
	xmlns:core="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
	xmlns:cards="clr-namespace:Syncfusion.Maui.Cards;assembly=Syncfusion.Maui.Cards"
             Shell.NavBarIsVisible="False">
    <core:SfBusyIndicator IsRunning="{Binding IsLoading}"
                          AnimationType="Cupertino"
                          Title="Obteniendo informacion..."
                          TextColor="{AppThemeBinding Light=Black, Dark=White}"
                          TitlePlacement="Bottom"
                          DurationFactor="0.2"
                          IndicatorColor="{AppThemeBinding Light=SkyBlue, Dark=#49CB}"
                          OverlayFill="{AppThemeBinding Light=White, Dark=Black}"
                          SizeFactor=".8"
                          TitleSpacing="20"
                          FontSize="18"
                          >
        
            
            <VerticalStackLayout HorizontalOptions="Fill" Margin="10,0,10,0" VerticalOptions="Center" >
            <Label Text="Tus productos:" Margin="10,20,0,0" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light=Black, Dark=White}"/>

            <CollectionView ItemsSource="{Binding ProductsList}"  Margin="0,30,0,0" HeightRequest="300">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="{x:Type models:Product}">
                            <cards:SfCardView
                            BackgroundColor="{AppThemeBinding Light=#FCFDFF, Dark=#010103}"
                            CornerRadius="12"
                            BorderColor="LightGray"
                            BorderWidth="1"
                            Padding="15"
                            VerticalOptions="Center"
                            HorizontalOptions="Fill"
                                Margin="0,0,0,10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Label 
                                         Grid.Row="0"
                                         Grid.Column="0"
                                         Text="{Binding ProductId}" 
                                         TextColor="{AppThemeBinding Light=Black, Dark=White}" 
                                         FontAttributes="Bold" 
                                         FontSize="15"/>
                                    <Label 
                                         Grid.Row="1"
                                         Grid.Column="0"
                                         Text="{Binding ProductName}" 
                                        LineBreakMode="TailTruncation" 
                                        MaxLines="1"
                                         TextColor="{AppThemeBinding Light=Black, Dark=White}" 
                                         FontSize="13" Margin="0,0,0,10"/>
                                    <Button Text="Check history" 
                                             Grid.Row="1" 
                                             Grid.Column="1" 
                                             VerticalOptions="End" 
                                             Margin="10,0,0,0"    
                                             HeightRequest="50"
                                             Command="{Binding Source={RelativeSource AncestorType={x:Type local:MainPageViewModel}}, Path=NavigateProductDetailsCommand}"
                                             CommandParameter="{Binding ProductId}"/>
                                </Grid>
                            </cards:SfCardView>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
    
        </VerticalStackLayout>

    </core:SfBusyIndicator>
</views:BasePage>