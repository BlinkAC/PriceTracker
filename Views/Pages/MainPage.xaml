    <ScrollView>

        <VerticalStackLayout
            Padding="30,0"
            Spacing="25"
            BackgroundColor="White" >
            <Button Text="Get Token" BackgroundColor="Aquamarine" Clicked="OnCounterClicked" WidthRequest="80" HeightRequest="80"></Button>
            <CollectionView ItemsSource="{Binding ProductsList}"  Margin="0,30,0,0">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="{x:Type models:Product}">
                        <VerticalStackLayout>


                            
                            <Grid Margin="0,0,0,10">
                                <Grid.RowDefinitions>
                                    <RowDefinition  />
                                    <RowDefinition  />
                                    <RowDefinition  />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition  />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>

                                <Label Grid.Row="0"
                                    FontSize="11" TextColor="Black">
                                    <Label.Text>
                                        <MultiBinding StringFormat="{}Identificador: {0} Nombre: {1}.">
                                            <Binding Path="ProductId" FallbackValue="" />
                                            <Binding Path="ProductName" FallbackValue="" />
                                        </MultiBinding>
                                    </Label.Text>
                                </Label>

                                <!--<Label Text="Verified:" Grid.Row="1" Grid.Column="0" VerticalOptions="Center" />-->
                                <!--CheckedChanged="OnProperty1CheckedChanged"-->
                                <!--<CheckBox IsChecked="{Binding ProductChecked}" Grid.Row="1" Grid.Column="1" VerticalOptions="Center"-->
                                <!--/>-->
                                <Button Text="Check history" 
                                        Grid.Row="1" 
                                        Grid.Column="1" 
                                        VerticalOptions="Center" 
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type local:MainPageViewModel}}, Path=NavigateProductDetailsCommand}"
                                        CommandParameter="{Binding ProductId}"/>

                            </Grid>

                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>

</views:BasePage>