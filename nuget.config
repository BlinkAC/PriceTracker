<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<packageSources>
		<add key="GitHub" value="https://nuget.pkg.github.com/BlinkAC/index.json" />
	</packageSources>
	<packageSourceCredentials>
		<GitHub>
			<add key="Username" value="username" />
			<add key="ClearTextPassword" value="password" />
		</GitHub>
	</packageSourceCredentials>
</configuration>
